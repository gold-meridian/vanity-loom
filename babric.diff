+	}
+
+	@Override
+	public InstallerData getInstallerData() {
+		return installerData;
+	}
+
+	@Override
+	public boolean isRootProject() {
+		return project.getRootProject() == project;
+	}
+
+	@Override
+	public MixinExtension getMixin() {
+		return this.mixinApExtension;
+	}
