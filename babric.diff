+							server.getEnvOnlyJar().toFile(),
+							getMergedJar().toFile()
+				);
+
+				createBackupJars(minecraftJars);
+			}
+
+			getMavenHelper(MinecraftJar.Type.MERGED).savePom();
+
+			if (context.applyDependencies()) {
