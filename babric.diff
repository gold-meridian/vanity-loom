+		}
+
+		@Override
+		public List<RemappedJars> getRemappedJars() {
+			return List.of(
+				new RemappedJars(minecraftProvider.getMergedJar(), getMergedJar(), minecraftProvider.getOfficialNamespace())
+			);
+		}
+
+		@Override
+		public List<MinecraftJar.Type> getDependencyTypes() {
