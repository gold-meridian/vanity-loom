diff -ruN babric-loom-plugin/src/test/resources/projects/multiproject/build.gradle fabric-loom/src/test/resources/projects/multiproject/build.gradle
--- babric-loom-plugin/src/test/resources/projects/multiproject/build.gradle	1969-12-31 18:00:00.000000000 -0600
